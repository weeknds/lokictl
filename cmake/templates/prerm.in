#!/bin/sh
# SPDX-FileCopyrightText: 2026 LokiCTL contributors
# SPDX-License-Identifier: MIT
#
# On removal, takes @APP_DISPLAY_NAME@'s own NetworkManager profiles away (by their
# exact names, which a quit with "Keep mode after quitting" on leaves
# running), its own firewall table (blocked devices on the hotspot, the VPN
# kill switch and the trap's chain), Share's interface (lokiap0) and the
# Wi-Fi survey's listening interface on a USB stick (lokimon0, left only by
# a survey that was killed), so nothing it made stays behind. The two
# interfaces go through the firewall helper itself: ap-del removes only
# lokiap0, and survey-off only a lokimon0 of LokiCTL's kind (monitor mode,
# on a USB stick). No other profile, table or interface is touched.

set -e

if [ "$1" = "remove" ] && [ -x /usr/bin/nmcli ]; then
    for profile in "LokiCTL hotspot" "LokiCTL VPN" "LokiCTL laptop link"; do
        /usr/bin/nmcli connection delete id "$profile" >/dev/null 2>&1 || true
    done
fi

if [ "$1" = "remove" ] && [ -x /usr/sbin/nft ]; then
    printf 'add table inet lokictl\ndelete table inet lokictl\n' | /usr/sbin/nft -f - || true
fi

if [ "$1" = "remove" ] && [ -x "@APP_HELPER_PATH@" ]; then
    "@APP_HELPER_PATH@" ap-del >/dev/null 2>&1 || true
    "@APP_HELPER_PATH@" survey-off >/dev/null 2>&1 || true
fi

exit 0
